# Required: API token from ThousandEyes Account Settings > Users and Roles > Profile
THOUSANDEYES_API_TOKEN="xyz"

# Optional: account group context (aid query parameter)
THOUSANDEYES_ACCOUNT_GROUP_ID=

# Optional: default role IDs assigned to new users (comma-separated)
THOUSANDEYES_DEFAULT_ROLE_IDS=

# Optional: login account group for the new user
THOUSANDEYES_LOGIN_ACCOUNT_GROUP_ID=
